# HiDock recorders. plugdev and the active seat user may claim the vendor interface.
# Install: sudo cp contrib/99-hidock.rules /etc/udev/rules.d/ && sudo udevadm control --reload-rules && sudo udevadm trigger --subsystem-match=usb --attr-match=idVendor=10d6

SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="10d6", ATTR{idProduct}=="af0c", MODE="0660", GROUP="plugdev", TAG+="uaccess"
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="10d6", ATTR{idProduct}=="b00c", MODE="0660", GROUP="plugdev", TAG+="uaccess"
